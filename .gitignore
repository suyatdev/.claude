# macOS
.DS_Store

# Runtime state & update artifacts
.last-cleanup
.last-update-result.json

# Statusline cumulative-token counters (machine-specific, regenerable)
/statusline-state/

# Pane-orchestration runtime state (session flags + per-run launchers, which
# contain copied prompts — machine-local, never committed)
/panes/state/

# Phase-guard runtime state (once-per-session fail-open flags — machine-local,
# never committed)
/hooks/state/

# Backup files
settings.json.bak
backups/

settings.json
stats-cache.json

# Cache & downloaded content
cache/
downloads/

# Conversation and session history (machine-specific, potentially sensitive)
history.jsonl
sessions/
session-env/
shell-snapshots/

# IDE lock files (machine-specific)
ide/

# Plugin cache & marketplace data (reinstallable, machine-specific)
plugins/

# Auth/session caches (machine-specific, potentially sensitive)
mcp-needs-auth-cache.json

# Project-specific local data (contains absolute local paths)
projects/

# Task runner data (machine-specific)
tasks/

# Background daemon state (machine-specific, potentially sensitive)
# Anchored to repo root (leading /) so these don't shadow same-named
# directories elsewhere in the tree, e.g. docs/superpowers/plans/.
/daemon/
/daemon.lock
/daemon.log
/daemon.status.json

# Local job queue & plan-mode scratch state (machine-specific)
/jobs/
/plans/

# Paste and file-edit history (machine-specific, potentially sensitive)
/paste-cache/
/file-history/

# GitHub PR status cache (machine-specific)
/gh-pr-status-cache.json

# memsearch index cache (regenerable, potentially sensitive)
/memory-index/

# claude-code-handoff session state (this repo is itself a git toplevel, so the
# vendored handoff hooks write their session files to a nested .claude/ here)
/.claude/

# Python bytecode / test caches (task-tracker)
__pycache__/
*.py[cod]
.pytest_cache/

# Retired memory tree (docs/features/rule-surface-trim.md, ADR 0031).
# CODING_MEMORY.md and coding-memory/ are frozen and local-only: they stay on
# disk, greppable and memsearch-able, and stay in git history, but are no longer
# pushed. The two verdict ledgers are the deliberate exception, and NOT because
# a missing one blocks PRs -- measured 2026-08-20 in a fresh detached worktree:
# judge-guard exits 2 either way, it only changes the message ("no verdict store"
# vs "no fresh verdict"). They are kept because they are the accumulated judge
# record -- both ledgers were already hundreds of rows deep at the split, a
# meaningful fraction carrying a calibration outcome. (Exact counts are
# deliberately not written here: they grow every judge run, and one written into
# this file went stale during the very session that added it. Derive them:
# `wc -l` the ledger, and parse `outcome` as JSON -- a grep for it matches the
# space in `"outcome": null` and overcounts.) Untracking them would fragment
# that history per
# worktree and leave the repo with no structured verdict record once the prose
# verdicts stop being tracked.
/CODING_MEMORY.md
/coding-memory/*
!/coding-memory/observability-judge/
/coding-memory/observability-judge/*
!/coding-memory/observability-judge/verdicts.jsonl
!/coding-memory/compliance-judge/
/coding-memory/compliance-judge/*
!/coding-memory/compliance-judge/verdicts.jsonl
